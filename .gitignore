backend/data/
backend/projects/
backend/target/
backend/src/main/resources/application.yml
*.mv.db
*.trace.db

# ── Secrets ──────────────────────────────────────────────
.env

# ── Frontend ─────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
